# =================================================================
# MULTI-CATEGORY VIRAL SHORTS ENGINE — PRODUCTION CONFIGURATION
# =================================================================

# Server & Environment
ENVIRONMENT=production          # development, test, production
LOG_LEVEL=INFO                  # DEBUG, INFO, WARNING, ERROR
PORT=8000
FAIL_CLOSED_IN_PRODUCTION=true  # Strictly enforce credentials in production

# Security & CORS (Do NOT use wildcard * with credentials in production)
CORS_ORIGINS=https://lovable.dev,https://lovable.app
ENGINE_API_KEY=your_secure_random_engine_api_key_here
ENGINE_API_KEY_PREVIOUS=        # Optional: allows seamless zero-downtime key rotation
TOKEN_ENCRYPTION_KEY=your_secret_32_byte_token_encryption_key_here
ADMIN_USER_IDS=                           # Comma-separated list of server-controlled admin user IDs
ADMIN_EMAILS=                             # Comma-separated list of server-controlled admin emails

# AI Model Provider (Gemini is primary provider, OpenAI is optional alternative)
LLM_PROVIDER=gemini             # gemini or openai
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Supabase (Database, Auth & Persistent Video Object Storage)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_for_user_auth
SUPABASE_STORAGE_BUCKET=shorts

# Redis & RQ Background Worker Queue
REDIS_URL=redis://localhost:6379/0
QUEUE_NAME=viral-shorts
MAX_CONCURRENT_JOBS=2
JOB_TIMEOUT_SECONDS=1800

# Buffer Publishing Integration (TikTok, YouTube Shorts, etc.)
BUFFER_CLIENT_ID=your_buffer_client_id_here
BUFFER_CLIENT_SECRET=your_buffer_client_secret_here
BUFFER_ACCESS_TOKEN=your_buffer_access_token_here
BUFFER_REDIRECT_URI=https://your-engine.onrender.com/api/v1/publishing/buffer/callback

# YouTube Data API OAuth 2.0 (Direct publishing fallback)
YOUTUBE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your_google_client_secret
YOUTUBE_REDIRECT_URI=https://your-engine.onrender.com/api/v1/auth/youtube/callback

# Production Quotas & Processing Limits
DAILY_TARGET_MIN=15
DAILY_TARGET_MAX=20
MAX_VIDEO_DURATION_SECONDS=7200
MAX_REQUEST_BODY_SIZE_BYTES=104857600  # 100MB limit

# Local Whisper & Processing Engine
LOCAL_WHISPER_MODEL=base        # tiny, base, small, medium, large-v3
LOCAL_WHISPER_DEVICE=auto       # auto, cpu, cuda
LOCAL_OUTPUT_DIR=output
DEFAULT_NUM_CLIPS=3
DEFAULT_ASPECT_RATIO=9:16

# Campaign-Aware Gaming Clipping Engine (Milestone 1)
ENFORCE_CAMPAIGN_GATE=true      # No campaign, no clipping. Enforces verified eligibility gate
DEFAULT_MONTHLY_EARNINGS_TARGET=500.0 # Target monthly earnings in USD ($500 target over 30 days)

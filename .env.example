# ---------------------------------------------------------------------------
# AI Video Editing Studio backend: every configuration variable.
# Copy to .env for local development. NEVER commit real values.
# Values shown are defaults unless marked REQUIRED.
# ---------------------------------------------------------------------------

# --- Runtime -----------------------------------------------------------------
ENVIRONMENT=development            # development | test | production
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173 # comma-separated; "*" is ignored
APP_NAME=AI Video Editing Studio

# --- Database (independent PostgreSQL) --------------------------------------
# REQUIRED. Use a dedicated database for this backend.
DATABASE_URL=postgresql://studio:studio@localhost:5432/studio

# --- Authentication -----------------------------------------------------------
# REQUIRED in production (32+ characters). HS256 secret that verifies bearer tokens.
AUTH_JWT_SECRET=
AUTH_JWT_AUDIENCE=authenticated
AUTH_TOKEN_LEEWAY_SECONDS=30
ADMIN_USER_IDS=                    # comma-separated subject IDs with admin rights
ADMIN_API_KEY=                     # optional operator key sent as X-Admin-Key

# --- Queue and workers ----------------------------------------------------------
# REQUIRED in production (redis:// or rediss://).
REDIS_URL=redis://localhost:6379/0
QUEUE_NAME=studio-jobs
JOB_TIMEOUT_SECONDS=7200
MAX_JOB_ATTEMPTS=3
STALE_HEARTBEAT_SECONDS=300
HEARTBEAT_INTERVAL_SECONDS=15
MAX_PARALLEL_RENDERS=2             # 1-5 clips rendered concurrently per job

# --- Storage ------------------------------------------------------------------
STORAGE_BACKEND=local              # local | supabase
STORAGE_LOCAL_ROOT=/var/data/studio-storage   # used when STORAGE_BACKEND=local
SUPABASE_URL=                      # https://<project>.supabase.co (STORAGE_BACKEND=supabase)
SUPABASE_SERVICE_ROLE_KEY=         # server-side only, never shipped to clients
SUPABASE_STORAGE_BUCKET=studio-private
SIGNED_URL_TTL_SECONDS=300         # download link lifetime
TEMP_DIR=/tmp/studio               # per-job scratch space; cleaned after each job
SOURCE_RETENTION_DAYS=30
TEMP_RETENTION_HOURS=6

# --- Upload and source limits -------------------------------------------------
MAX_UPLOAD_BYTES=524288000         # 500 MiB
MAX_SOURCE_DURATION_SECONDS=1800   # 30 minutes
MIN_SOURCE_DURATION_SECONDS=20

# --- YouTube retrieval (yt-dlp) ----------------------------------------------
# Off by default. Enable only for sources you have the rights to process.
YOUTUBE_RETRIEVAL_ENABLED=false
YTDLP_TIMEOUT_SECONDS=900
YTDLP_RETRIES=2
YTDLP_MAX_HEIGHT=1080

# --- AI highlight analysis ----------------------------------------------------
# Sends transcript text and timestamps only; no audio or video leaves the server.
AI_PROVIDER=gemini                 # gemini (fake is for tests only and refused in production)
GEMINI_API_KEY=                    # REQUIRED for gemini
GEMINI_MODEL=gemini-2.5-flash
AI_TIMEOUT_SECONDS=120
AI_MAX_RETRIES=3

# --- Transcription (faster-whisper, runs locally) -----------------------------
WHISPER_MODEL=base                 # tiny | base | small | medium | large-v3
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- Clip selection and rendering --------------------------------------------
CLIP_COUNT=5                       # fixed by product: must be 5
CLIP_MIN_SECONDS=15
CLIP_MAX_SECONDS=90
MIN_CLIP_SCORE=75                  # engagement score a moment must reach
OUTPUT_WIDTH=1080
OUTPUT_HEIGHT=1920
FFMPEG_TIMEOUT_SECONDS=900
FFMPEG_THREADS=0                   # 0 = FFmpeg decides
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
CAPTION_PRESET=bold_creator        # clean_minimal | bold_creator | high_contrast | modern_short | highlight_keywords

# --- API protection -----------------------------------------------------------
RATE_LIMIT_PER_MINUTE=120
REQUEST_TIMEOUT_SECONDS=60

# --- Test-only (not read by the application) -----------------------------------
# TEST_DATABASE_URL=postgresql://postgres@localhost:5432/postgres

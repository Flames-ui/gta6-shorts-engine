# =================================================================
# GTA 6 SHORTS ENGINE — PRODUCTION CONFIGURATION TEMPLATE
# =================================================================

# Environment & Server
ENVIRONMENT=production          # development, test, production
LOG_LEVEL=INFO                  # DEBUG, INFO, WARNING, ERROR
PORT=8000
CORS_ORIGINS=*                  # Comma-separated list or * for dashboard access

# Engine Security Authentication
# Secure API key required in the X-API-Key or Authorization header for protected endpoints
ENGINE_API_KEY=your_secure_engine_api_key_here

# AI Model Provider (Gemini is primary, OpenAI is fallback)
LLM_PROVIDER=gemini             # gemini or openai
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Supabase Integration (PostgreSQL Database & Persistent Storage)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here
SUPABASE_STORAGE_BUCKET=gta6-shorts

# Redis Task Queue (Required for Background Worker)
REDIS_URL=redis://localhost:6379/0
QUEUE_NAME=gta6-shorts
MAX_CONCURRENT_JOBS=2
JOB_TIMEOUT_SECONDS=1800

# Whisper & Local Video Processing Configuration
LOCAL_WHISPER_MODEL=base        # tiny, base, small, medium, large-v3
LOCAL_WHISPER_DEVICE=auto       # auto, cpu, cuda
LOCAL_OUTPUT_DIR=output
DEFAULT_NUM_CLIPS=3
DEFAULT_ASPECT_RATIO=9:16
MAX_VIDEO_DURATION_SECONDS=7200

# YouTube Data API OAuth 2.0 (For authorized Shorts publishing)
YOUTUBE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your_google_oauth_client_secret
YOUTUBE_REDIRECT_URI=https://your-engine-url.onrender.com/api/v1/auth/youtube/callback

# Legacy / Optional External API Mode
MUAPI_API_KEY=your_optional_muapi_key_here
MUAPI_BASE_URL=https://api.muapi.ai/api/v1
